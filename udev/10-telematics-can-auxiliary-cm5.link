# CM5 onboard MCP2518FD SPI CS1 (platform-1f0005c000.spi-cs-1)
# Board silkscreen / physical AUX bus → can_auxiliary
# (DT node is can1@1; do not trust kernel can0/can1 order.)
# Install: /etc/systemd/network/10-telematics-can-auxiliary-cm5.link

[Match]
Type=can
Path=platform-1f0005c000.spi-cs-1
Driver=mcp251xfd

[Link]
Name=can_auxiliary
MACAddressPolicy=none
NamePolicy=
