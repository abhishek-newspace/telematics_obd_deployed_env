# reComputer Industrial — CAN naming (onboard MCP2518FD + USB-CAN actuator)
#
# Mapping (verified 2026-09-09 — names follow board silkscreen, not DT can0/can1):
#   can_auxiliary  ← MCP2518FD SPI CS1 (platform-1f0005c000.spi-cs-1)  physical AUX
#   can_control    ← MCP2518FD SPI CS0 (platform-1f0005c000.spi-cs-0)  physical CONTROL
#   can_actuator   ← USB CH340 serial CAN @ 2 Mbps (ttyUSB3)
#                    ID_PATH=platform-xhci-hcd.1-usb-0:1.1.4:1.0
#                    → /dev/telematics/can_actuator
#
# Do NOT match every 1a86:7523 — only this hub path is the actuator.
# Motor adapters on this unit are Prolific (067b:23a3), not CH340.
#
# can_log.conf:
#   can0_device=can_auxiliary
#   can1_device=/dev/telematics/can_actuator  (or by-path)
#   can2_device=can_control
#
# Install: sudo ./apply-usb-mapping.sh  (+ .link files via install-cm5-setup.sh)

# --- Onboard MCP2518FD SocketCAN (Path-based rename; ignore can0/can1 order) --
# CS1 = AUX, CS0 = CONTROL (see 10-telematics-can-*-cm5.link)

SUBSYSTEM=="net", ACTION=="add", KERNEL=="can*", ENV{ID_PATH}=="platform-1f0005c000.spi-cs-1", \
    RUN+="/usr/local/sbin/telematics-can-rename.sh %k can_auxiliary"

SUBSYSTEM=="net", ACTION=="add", KERNEL=="can*", ENV{ID_PATH}=="platform-1f0005c000.spi-cs-0", \
    RUN+="/usr/local/sbin/telematics-can-rename.sh %k can_control"

# --- USB-CAN actuator: CH340 on hub path 1.1.4 --------------------------------
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="7523", \
    ENV{ID_PATH}=="platform-xhci-hcd.1-usb-0:1.1.4:1.0", \
    ENV{ID_MM_DEVICE_IGNORE}="1", \
    ENV{ID_MM_PORT_IGNORE}="1", \
    ENV{MOBILE_BROADBAND_DEVICE_IGNORE}="1", \
    ENV{BRLTTY_BRAILLE_DRIVER}="none"

SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    ENV{ID_PATH}=="platform-xhci-hcd.1-usb-0:1.1.4:1.0", \
    ENV{ID_MM_DEVICE_IGNORE}="1", \
    SYMLINK+="telematics/can_actuator", GROUP="dialout", MODE="0660"

# USB SocketCAN (gs_usb / candleLight) — optional second adapter
SUBSYSTEM=="net", ACTION=="add", KERNEL=="can*", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", \
    RUN+="/usr/local/sbin/telematics-can-rename.sh %k can_actuator_usb"
