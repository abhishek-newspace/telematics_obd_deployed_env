# CM5 onboard MCP2518FD SPI CS0 (platform-1f0005c000.spi-cs-0)
# Board silkscreen / physical CONTROL bus → can_control
# (DT node is can0@0; do not trust kernel can0/can1 order.)
# Install: /etc/systemd/network/10-telematics-can-control-cm5.link

[Match]
Type=can
Path=platform-1f0005c000.spi-cs-0
Driver=mcp251xfd

[Link]
Name=can_control
MACAddressPolicy=none
NamePolicy=
